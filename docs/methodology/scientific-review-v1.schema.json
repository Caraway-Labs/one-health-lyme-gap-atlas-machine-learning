rties": {"reproducibility": {"const": "BLOCKED"}}}}}, {"properties": {"checks": {"properties": {"interpretation": {"const": "BLOCKED"}}}}}]}}, {"if": {"properties": {"disposition": {"const": "NEEDS_DECISION"}}}, "then": {"anyOf": [{"properties": {"checks": {"properties": {"problem_target": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"point_in_time": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"leakage": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"holdout": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"baseline": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"metrics": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"limitations": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"reproducibility": {"const": "NEEDS_DECISION"}}}}}, {"properties": {"checks": {"properties": {"interpretation": {"const": "NEEDS_DECISION"}}}}}]}}]
